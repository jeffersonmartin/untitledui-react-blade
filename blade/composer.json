{
    "name": "untitledui/blade",
    "description": "UntitledUI Blade component library for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0"
    },
    "suggest": {
        "gehrisandro/tailwind-merge-laravel": "For intelligent Tailwind CSS class merging in the cx() helper."
    },
    "autoload": {
        "psr-4": {
            "UntitledUi\\Blade\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "UntitledUi\\Blade\\UntitledUiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
